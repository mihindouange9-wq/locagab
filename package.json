{
  "name": "locagab-site",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 5180",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 127.0.0.1 --port 5181",
    "typecheck": "tsc --noEmit",
    "verify": "node tools/check.mjs http://127.0.0.1:5182",
    "deploy:pages": "node tools/deploy-pages.mjs",
    "charte:build": "node charte/build.mjs",
    "charte:check": "node tools/charte-verifier.mjs",
    "charte:pdf": "node tools/charte-pdf.mjs",
    "charte": "npm run charte:build && npm run charte:check && npm run charte:pdf",
    "video:scene": "node video/build-scene.mjs",
    "video:apercu": "node video/build-scene.mjs && node tools/video-render.mjs --apercu",
    "video": "node video/build-scene.mjs && node tools/video-render.mjs",
    "video:check": "node tools/video-check.mjs"
  },
  "dependencies": {
    "@fontsource-variable/manrope": "^5.2.5",
    "@gsap/react": "^2.1.2",
    "gsap": "^3.13.0",
    "lucide-react": "^0.511.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^4.4.1",
    "pngjs": "^7.0.0",
    "potrace": "^2.1.8",
    "puppeteer-core": "^25.12.0",
    "typescript": "^5.8.3",
    "vite": "^6.3.5"
  },
  "overrides": {
    "rollup": "4.40.0",
    "esbuild": "0.25.4"
  },
  "engines": {
    "node": ">=20"
  }
}
